class Solution:
    def maxSubArray(self, nums):
        def helper(left, right):
            if left == right:
                return nums[left]

            mid = (left + right) // 2

            left_sum = helper(left, mid)
            right_sum = helper(mid + 1, right)
            cross_sum = max_crossing_sum(left, mid, right)

            return max(left_sum, right_sum, cross_sum)

        def max_crossing_sum(left, mid, right):
            left_best = float('-inf')
            total = 0
            for i in range(mid, left - 1, -1):
                total += nums[i]
                left_best = max(left_best, total)

            right_best = float('-inf')
            total = 0
            for i in range(mid + 1, right + 1):
                total += nums[i]
                right_best = max(right_best, total)

            return left_best + right_best

        return helper(0, len(nums) - 1)
